# UI Toolkit - Caddy Configuration for "LAN with login"
# Selected by setup.sh option 2 (CADDYFILE=Caddyfile.lan in .env) and used
# with: docker compose --profile production up -d
#
# DOMAIN is a LAN IP address or hostname (e.g. 192.168.1.50, toolkit.lan).
# Caddy issues a certificate from its own local CA ("tls internal"), so no
# public domain or Let's Encrypt is needed. Browsers warn once unless you
# trust Caddy's root CA (/data/caddy/pki/authorities/local/root.crt).
#
# No HSTS header here: HSTS on a self-signed certificate can lock browsers
# out of the site.

{$DOMAIN} {
    tls internal

    # Reverse proxy to the UI Toolkit application
    reverse_proxy unifi-toolkit:8000 {
        # Health checks
        health_uri /health
        health_interval 30s
        health_timeout 5s
    }

    header {
        # Remove server header
        -Server
    }

    # Enable compression
    encode gzip zstd

    # Logging
    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }
}
